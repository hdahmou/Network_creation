{
  "scheduler_address": "tcp://127.0.0.1:8786",
  "task": "best-response-policy",
  "output_dir": "../../artifacts/best_response_policy",
  "write_batch_size": 64,
  "input_spec": {
    "log2_budget": 6,
    "sampler_seed": 123,
    "parameters": {
      "benefit_to_cost_ratio": {
        "type": "fixed",
        "payload": 0.5
      },
      "distance_discount": {
        "type": "fixed",
        "payload": 0.9
      },
      "bridge_value": {
        "type": "continuous",
        "payload": {
          "min": -0.5,
          "max": 0.5
        }
      },
      "inertia_term": {
        "type": "continuous",
        "payload": {
          "min": -0.5,
          "max": 0.5
        }
      },
      "tau": {
        "type": "continuous",
        "payload": {
          "min": 0.0,
          "max": 0.5
        }
      },
      "visibility_fraction": {
        "type": "fixed",
        "payload": 0.2
      }
    }
  },
  "simulation": {
    "n_agents": 10,
    "actor_scheduler": {
      "fraction": 0.1
    },
    "seed": 11,
    "max_steps": 360,
    "n_episodes": 16,
    "stagnation_patience": null,
    "initial_graph": {
      "kind": "empty"
    }
  },
  "observers": [
    {
      "name": "density",
      "output": "mean",
      "kwargs": {
        "observation_sampling": { "kind": "periodic", "every": 1 },
        "aggregations": ["mean", "std"]
      }
    },
    {
      "name": "normalized_welfare",
      "output": "mean",
      "kwargs": {
        "observation_sampling": { "kind": "periodic", "every": 1 },
        "aggregations": ["mean", "std"],
        "benefit_to_cost_ratio": 0.5,
        "distance_discount": 0.9
      }
    }
  ]
}
