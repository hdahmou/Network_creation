{
  "scheduler_address": "tcp://127.0.0.1:8786",
  "task": "best-response-policy",
  "output_dir": "../../artifacts/best_response_policy",
  "write_batch_size": 64,
  "input_spec": {
    "log2_budget": 4,
    "sampler_seed": 123,
    "parameters": {
      "benefit_to_cost_ratio": {
        "type": "fixed",
        "payload": 0.5
      },
      "distance_discount": {
        "type": "fixed",
        "payload": 0.9
      },
      "bridge_value": {
        "type": "continuous",
        "payload": {
          "min": -1.0,
          "max": 1.0
        }
      },
      "inertia_term": {
        "type": "continuous",
        "payload": {
          "min": -1.0,
          "max": 1.0
        }
      },
      "tau": {
        "type": "continuous",
        "payload": {
          "min": 0.001,
          "max": 1.0
        }
      },
      "visibility_distance": {
        "type": "fixed",
        "payload": 3
      }
    }
  },
  "simulation": {
    "n_agents": [10, 50],
    "actor_scheduler": {
      "n_actors": 1
    },
    "seed": 11,
    "max_steps": 360,
    "n_episodes": 1,
    "stagnation_patience": null,
    "initial_graph": {
      "kind": "empty"
    }
  },
  "observers": [
    {
      "name": "central_point_of_dominance",
      "output": "mean",
      "kwargs": {
        "observation_sampling": { "kind": "periodic", "every": 1 },
        "aggregations": ["mean"]
      }
    },
    {
      "name": "normalized_welfare",
      "output": "mean",
      "kwargs": {
        "observation_sampling": { "kind": "periodic", "every": 1 },
        "aggregations": ["mean"]
      }
    }
  ]
}
