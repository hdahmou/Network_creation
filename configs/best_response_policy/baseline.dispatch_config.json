{
  "scheduler_address": "tcp://127.0.0.1:8786",
  "task": "best-response-policy",
  "output_dir": "../../artifacts/best_response_policy",
  "write_batch_size": 64,
  "input_spec": {
    "log2_budget": 16,
    "sampler_seed": 123,
    "parameters": {
      "benefit_to_cost_ratio": {
        "type": "scaled_inverse_n_agents",
        "payload": {
          "numerator": 10.0,
          "factor": 2.0
        }
      },
      "distance_discount": {
        "type": "fixed",
        "payload": 0.9
      },
      "outside_optimism": {
        "type": "continuous",
        "payload": {
          "min": 0.0,
          "max": 1.0
        }
      },
      "exploration": {
        "type": "continuous",
        "payload": {
          "min": 0.0,
          "max": 1.0
        }
      },
      "visibility_distance": {
        "type": "fixed",
        "payload": 3
      }
    }
  },
  "simulation": {
    "n_agents": [
      10,
      25,
      50
    ],
    "actor_scheduler": {
      "n_actors": 1
    },
    "seed": 11,
    "max_steps": 500,
    "n_episodes": 32,
    "stagnation_patience": 100,
    "initial_graph": {
      "kind": "empty"
    }
  },
  "observers": [
    {
      "name": "central_point_of_dominance",
      "output": "mean",
      "kwargs": {
        "observation_sampling": {
          "kind": "periodic",
          "every": 5
        },
        "aggregations": [
          "mean",
          "std"
        ]
      }
    },
    {
      "name": "indegree",
      "output": "mean",
      "kwargs": {
        "observation_sampling": {
          "kind": "periodic",
          "every": 5
        },
        "aggregations": [
          "mean",
          "std"
        ]
      }
    },
    {
      "name": "distance",
      "output": "mean",
      "kwargs": {
        "observation_sampling": {
          "kind": "periodic",
          "every": 5
        },
        "aggregations": [
          "mean",
          "std"
        ]
      }
    },
    {
      "name": "normalized_welfare",
      "output": "mean",
      "kwargs": {
        "observation_sampling": {
          "kind": "periodic",
          "every": 5
        },
        "aggregations": [
          "mean",
          "std"
        ]
      }
    }
  ]
}