{
  "scheduler_address": "tcp://127.0.0.1:8786",
  "task": "best-response-policy",
  "output_dir": "../../artifacts/best_response_policy",
  "write_batch_size": 32,
  "input_spec": {
    "log2_budget": 4,
    "sampler_seed": 123,
    "parameters": {
      "benefit_to_cost_ratio": {
        "type": "fixed",
        "payload": 0.5
      },
      "distance_discount": {
        "type": "continuous",
        "payload": {
          "min": 0.01,
          "max": 0.99
        }
      },
      "bridge_value_scale": {
        "type": "continuous",
        "payload": {
          "min": 0.0,
          "max": 1.0
        }
      },
      "inertia_term": {
        "type": "continuous",
        "payload": {
          "min": 0.0,
          "max": 0.5
        }
      },
      "visibility_fraction": {
        "type": "fixed",
        "payload": 1.0
      }
    }
  },
  "simulation": {
    "n_agents": 10,
    "actor_scheduler": {
      "fraction": 1.0
    },
    "seed": 11,
    "max_steps": 360,
    "n_episodes": 32,
    "stagnation_patience": null,
    "initial_graph": {
      "kind": "empty"
    }
  },
  "observers": [
    {
      "name": "density",
      "output": "mean",
      "kwargs": {
        "observation_sampling": {"kind": "periodic", "every": 1},
        "aggregations": ["mean"]
      }
    },
    {
      "name": "normalized_welfare",
      "output": "mean",
      "kwargs": {
        "observation_sampling": {"kind": "periodic", "every": 1},
        "aggregations": ["mean"],
        "benefit_to_cost_ratio": 0.5,
        "distance_discount": 0.9
      }
    }
  ]
}
