{
  "execution": {
    "scheduler_address": "tcp://127.0.0.1:8786",
    "output_dir": "../artifacts/simulation_runs",
    "write_batch_size": 64
  },
  "sampling": {
    "log2_budget": 12,
    "seed": 123
  },
  "simulator": {
    "seed": 11,
    "max_steps": 500,
    "n_episodes": 16,
    "stagnation_patience": 100,
    "actor_scheduler": {
      "n_actors": 1
    },
    "initial_graph": {
      "kind": "empty"
    }
  },
  "game": {
    "benefit_to_cost_ratio": {
      "kind": "scaled_inverse_agents",
      "numerator": 10.0,
      "factor": 2.0
    },
    "distance_discount": {
      "kind": "fixed",
      "value": 0.9
    }
  },
  "population": {
    "n_agents": [10, 20],
    "visibility_distance": {
      "kind": "fixed",
      "value": 20
    },
    "policies": [
      {
        "id": "best_response",
        "kind": "best-response",
        "parameters": {
          "outside_optimism": {
            "kind": "continuous",
            "min": 0.0,
            "max": 1.0
          },
          "exploration": {
            "kind": "continuous",
            "min": 0.001,
            "max": 0.4
          }
        }
      },
      {
        "id": "random",
        "kind": "random",
        "parameters": {}
      }
    ],
    "policy_proportions": {
      "policy": "best_response",
      "values": [0.0, 0.1, 0.9]
    }
  },
  "observers": {
    "defaults": {
      "sampling": {
        "kind": "periodic",
        "every": 5
      },
      "aggregations": ["mean", "std"]
    },
    "outputs": [
      {
        "name": "central_point_of_dominance",
        "output": "mean"
      },
      {
        "name": "indegree",
        "output": "mean"
      },
      {
        "name": "distance",
        "output": "mean"
      },
      {
        "name": "centered_mean_welfare",
        "output": "mean"
      }
    ]
  }
}
