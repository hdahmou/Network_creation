{
  "execution": {
    "scheduler_address": "tcp://127.0.0.1:8786",
    "output_dir": "../artifacts/simulation_runs",
    "write_batch_size": 32
  },
  "sampling": {
    "log2_budget": 4,
    "seed": 123
  },
  "simulator": {
    "seed": 11,
    "max_steps": 360,
    "n_episodes": 32,
    "stagnation_patience": null,
    "actor_scheduler": {
      "n_actors": 1
    },
    "initial_graph": {
      "kind": "empty"
    }
  },
  "game": {
    "benefit_to_cost_ratio": {
      "kind": "scaled_inverse_agents",
      "numerator": 10.0,
      "factor": 2.0
    },
    "distance_discount": {
      "kind": "continuous",
      "min": 0.01,
      "max": 0.99,
      "std": 0.0
    }
  },
  "population": {
    "n_agents": 10,
    "visibility_distance": {
      "kind": "fixed",
      "value": 10
    },
    "policies": [
      {
        "id": "myopic",
        "kind": "myopic",
        "parameters": {
          "bridge_probability": {
            "kind": "continuous",
            "min": 0.0,
            "max": 1.0,
            "std": 0.0
          }
        }
      }
    ],
    "policy_proportions": {
      "policy": "myopic",
      "values": [1.0]
    }
  },
  "observers": {
    "defaults": {
      "sampling": {
        "kind": "periodic",
        "every": 1
      },
      "aggregations": ["mean"]
    },
    "outputs": [
      {
        "name": "density",
        "output": "mean"
      },
      {
        "name": "centered_mean_welfare",
        "output": "mean"
      }
    ]
  }
}
