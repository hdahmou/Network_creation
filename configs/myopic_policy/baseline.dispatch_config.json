{
  "scheduler_address": "tcp://127.0.0.1:8786",
  "task_class": "tasks.myopic_policy:myopicPolicyRun",
  "write_batch_size": 4,
  "input_spec": {
    "log2_budget": 7,
    "sampler_seed": 123,
    "parameters": {
      "link_cost": 20,
      "decay": {
        "min": 0.1,
        "max": 0.9
      },
      "per_link_benefit": 10.0,
      "bridge_probability": {
        "min": 0.0,
        "max": 1.0
      }
    }
  },
  "simulation": {
    "n_agents": 10,
    "radius": 10,
    "mode": "SIMULTANEOUS",
    "seed": 11,
    "max_steps": 360,
    "n_episodes": 32,
    "stagnation_patience": null,
    "initial_graph": {
      "kind": "empty"
    }
  },
  "observers": [
    {
      "name": "density",
      "output": "mean",
      "kwargs": {
        "observation_frequency": 1,
        "aggregations": ["mean"]
      }
    },
    {
      "name": "social_welfare",
      "output": "mean",
      "kwargs": {
        "observation_frequency": 1,
        "aggregations": ["mean"],
        "link_cost": 20.0,
        "decay": 0.9,
        "per_link_benefit": 10.0
      }
    }
  ]
}
