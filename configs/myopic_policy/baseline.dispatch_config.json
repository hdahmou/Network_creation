{
  "scheduler_address": "tcp://127.0.0.1:8786",
  "task": "myopic-policy",
  "output_dir": "../../artifacts/myopic_policy",
  "write_batch_size": 32,
  "input_spec": {
    "log2_budget": 4,
    "sampler_seed": 123,
    "parameters": {
      "link_cost": {
        "type": "fixed",
        "payload": 20
      },
      "decay": {
        "type": "continuous",
        "payload": {
          "min": 0.01,
          "max": 0.99
        }
      },
      "per_link_benefit": {
        "type": "fixed",
        "payload": 10.0
      },
      "bridge_probability": {
        "type": "continuous",
        "payload": {
          "min": 0.0,
          "max": 1.0
        }
      },
      "radius": {
        "type": "fixed",
        "payload": 10
      }
    }
  },
  "simulation": {
    "n_agents": 10,
    "mode": "SIMULTANEOUS",
    "seed": 11,
    "max_steps": 360,
    "n_episodes": 32,
    "stagnation_patience": null,
    "initial_graph": {
      "kind": "empty"
    }
  },
  "observers": [
    {
      "name": "density",
      "output": "mean",
      "kwargs": {
        "observation_sampling": {"kind": "periodic", "every": 1},
        "aggregations": ["mean"]
      }
    },
    {
      "name": "social_welfare",
      "output": "mean",
      "kwargs": {
        "observation_sampling": {"kind": "periodic", "every": 1},
        "aggregations": ["mean"],
        "link_cost": 20.0,
        "decay": 0.9,
        "per_link_benefit": 10.0
      }
    }
  ]
}
