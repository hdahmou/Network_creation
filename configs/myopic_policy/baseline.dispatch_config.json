{
  "scheduler_address": "tcp://127.0.0.1:8786",
  "task": "myopic-policy",
  "output_dir": "../../artifacts/myopic_policy",
  "write_batch_size": 32,
  "input_spec": {
    "log2_budget": 4,
    "sampler_seed": 123,
    "parameters": {
      "benefit_to_cost_ratio": {
        "type": "fixed",
        "payload": 0.5
      },
      "distance_discount": {
        "type": "continuous",
        "payload": {
          "min": 0.01,
          "max": 0.99
        }
      },
      "bridge_probability": {
        "type": "continuous",
        "payload": {
          "min": 0.0,
          "max": 1.0
        }
      },
      "visibility_distance": {
        "type": "fixed",
        "payload": 10
      }
    }
  },
  "simulation": {
    "n_agents": 10,
    "actor_scheduler": {
      "n_actors": 1
    },
    "seed": 11,
    "max_steps": 360,
    "n_episodes": 32,
    "stagnation_patience": null,
    "initial_graph": {
      "kind": "empty"
    }
  },
  "observers": [
    {
      "name": "density",
      "output": "mean",
      "kwargs": {
        "observation_sampling": { "kind": "periodic", "every": 1 },
        "aggregations": ["mean"]
      }
    },
    {
      "name": "normalized_welfare",
      "output": "mean",
      "kwargs": {
        "observation_sampling": { "kind": "periodic", "every": 1 },
        "aggregations": ["mean"]
      }
    }
  ]
}
