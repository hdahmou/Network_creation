{
  "scheduler_address": "tcp://127.0.0.1:8786",
  "task": "random-policy",
  "output_dir": "../../artifacts/random_policy",
  "write_batch_size": 4,
  "input_spec": {
    "log2_budget": 0,
    "sampler_seed": 123,
    "parameters": {
      "benefit_to_cost_ratio": {
        "type": "scaled_inverse_n_agents",
        "payload": {
          "numerator": 10.0,
          "factor": 2.0
        }
      },
      "visibility_distance": {
        "type": "fixed",
        "payload": 4
      }
    }
  },
  "simulation": {
    "n_agents": 5,
    "actor_scheduler": {
      "n_actors": 4
    },
    "seed": 11,
    "max_steps": 5,
    "n_episodes": 3,
    "stagnation_patience": null,
    "initial_graph": {
      "kind": "empty"
    }
  },
  "observers": [
    {
      "name": "density",
      "output": "mean",
      "kwargs": {
        "observation_sampling": {"kind": "periodic", "every": 1},
        "aggregations": [
          "mean"
        ]
      }
    },
    {
      "name": "centered_mean_welfare",
      "output": "mean",
      "kwargs": {
        "observation_sampling": {"kind": "periodic", "every": 1},
        "aggregations": [
          "mean"
        ],
        "distance_discount": 0.5
      }
    }
  ]
}
