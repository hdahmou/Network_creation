{
  "execution": {
    "scheduler_address": "tcp://127.0.0.1:8786",
    "output_dir": "../artifacts/simulation_runs",
    "write_batch_size": 64
  },
  "sampling": {
    "log2_budget": 15,
    "seed": 13
  },
  "simulator": {
    "seed": 13,
    "budget": {
      "kind": "activation_opportunities_per_agent",
      "value": 60
    },
    "n_episodes": 32,
    "actor_scheduler": {
      "n_actors": 1
    },
    "initial_graph": {
      "kind": "empty"
    }
  },
  "game": {
    "benefit_to_cost_ratio": {
      "kind": "scaled_inverse_agents",
      "numerator": 10.0,
      "factor": 2.0
    },
    "distance_discount": {
      "kind": "fixed",
      "value": 0.9
    }
  },
  "population": {
    "n_agents": [
      10,
      50,
      100
    ],
    "agent_parameters": {
      "activation_weight": {
        "kind": "fixed",
        "value": 1.0
      }
    },
    "visibility_distance": {
      "kind": "sampled_discrete_range",
      "min": 2,
      "max": 6,
      "step": 1,
      "heterogeneity": {
        "kind": "three_point",
        "probabilities": [0.25, 0.5, 0.25]
      }
    },
    "policies": [
      {
        "id": "best_response",
        "kind": "best-response",
        "parameters": {
          "outside_optimism": {
            "kind": "continuous",
            "min": 0.0,
            "max": 1.0,
            "heterogeneity": {
              "kind": "normal",
              "std": 0.2
            }
          },
          "exploration": {
            "kind": "continuous",
            "min": 0.0001,
            "max": 0.1,
            "heterogeneity": {
              "kind": "normal",
              "std": 0.02
            }
          }
        }
      }
    ],
    "policy_proportions": {
      "policy": "best_response",
      "values": [
        1.0
      ]
    }
  },
  "observers": {
    "defaults": {
      "sampling": {
        "kind": "periodic",
        "every": 1
      },
      "aggregations": [
        "mean",
        "std"
      ]
    },
    "outputs": [
      {
        "name": "central_point_of_dominance"
      },
      {
        "name": "indegree"
      },
      {
        "name": "centered_mean_welfare"
      },
      {
        "name": "hub_sponsorship"
      },
      {
        "name": "agent_payoff",
        "sampling": {
          "kind": "terminal"
        },
        "aggregations": ["runs"]
      }
    ]
  }
}
