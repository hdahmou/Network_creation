{
  "execution": {
    "scheduler_address": "tcp://127.0.0.1:8786",
    "output_dir": "../artifacts/simulation_runs",
    "write_batch_size": 64
  },
  "sampling": {
    "log2_budget": 15,
    "seed": 13
  },
  "simulator": {
    "seed": 13,
    "budget": {
      "kind": "activation_opportunities_per_agent",
      "value": 60
    },
    "n_episodes": 32,
    "actor_scheduler": {
      "n_actors": 1
    },
    "initial_graph": {
      "kind": "empty"
    }
  },
  "game": {
    "benefit_to_cost_ratio": {
      "kind": "scaled_inverse_agents",
      "numerator": 10.0,
      "factor": 2.0
    },
    "distance_discount": {
      "kind": "fixed",
      "value": 0.9
    }
  },
  "population": {
    "n_agents": [10, 50, 100],
    "agent_parameters": {
      "activation_weight": {
        "kind": "fixed",
        "value": 1.0
      }
    },
    "visibility_distance": {
      "kind": "sampled_discrete_range",
      "min": 1,
      "max": 7,
      "step": 1
    },
    "policies": [
      {
        "id": "best_response",
        "kind": "best-response",
        "parameters": {
          "outside_optimism": {
            "kind": "continuous",
            "min": 0.0,
            "max": 1.0,
            "heterogeneity": {
              "kind": "normal",
              "std": 0.0
            }
          },
          "exploration": {
            "kind": "continuous",
            "min": 0.0001,
            "max": 0.1,
            "heterogeneity": {
              "kind": "normal",
              "std": 0.0
            }
          }
        }
      },
      {
        "id": "random",
        "kind": "random",
        "agent_parameters": {
          "activation_weight": {
            "kind": "continuous",
            "min": 0.01,
            "max": 1.0,
            "heterogeneity": {
              "kind": "normal",
              "std": 0.0
            }
          }
        },
        "parameters": {}
      }
    ],
    "policy_counts": {
      "policy": "best_response",
      "kind": "balanced"
    }
  },
  "observers": {
    "defaults": {
      "sampling": {
        "kind": "periodic",
        "every": 5
      },
      "aggregations": ["mean"]
    },
    "outputs": [
      {
        "name": "policy_welfare"
      },
      {
        "name": "central_point_of_dominance"
      },
      {
        "name": "indegree"
      },
      {
        "name": "hub_sponsorship"
      }
    ]
  }
}
